{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],

    "strict": false,
    "noImplicitAny": false,
    "sourceMap": true,
    "allowJs": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmitOnError": true
  },
  "include": [
    "HTTPAPI/WebAPI/HTTPRoot/events/**/*.ts"
  ]
}
